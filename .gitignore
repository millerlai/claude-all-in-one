# Personal, machine-specific: absolute paths, usernames, pinned plugin-cache
# versions. `.claude/settings.json` beside it IS tracked - that one carries the
# repo's shared hooks.
.claude/settings.local.json

__pycache__/

# `pytest --cov` output (see pyproject.toml's [tool.coverage.run]).
.coverage
.coverage.*
coverage.xml

# What cai writes into a project. `.cai/` carries its own `.gitignore` of `*`,
# but a fresh clone has none until cai first runs, so it is listed here too.
.cai/

# Where cai kept the same things before it moved them into `.cai/`: track
# state, the glossary, the review policy and the config. An installed cai older
# than that move still writes here, and the next one moves them out.
.claude/track/
.claude/cai-context.md
.claude/cai-review.md
.claude/cai.json

# Worktrees left over from other work: an untracked `.claude/worktrees/`
# would otherwise dirty ship's clean_tree check (#202).
.claude/worktrees/

# Scratch and reference material. Tracked docs stay tracked; new ones need
# an explicit `git add -f`.
docs/
