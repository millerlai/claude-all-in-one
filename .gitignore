# Personal, machine-specific: absolute paths, usernames, pinned plugin-cache
# versions. `.claude/settings.json` beside it IS tracked - that one carries the
# repo's shared hooks.
.claude/settings.local.json

__pycache__/

# Per-feature track state: state.md and the attempt ledger beside it. Local
# working state for whoever is driving a track, not something to share -- and
# the ledger is append-only, so a tracked one would conflict on every merge.
.claude/track/

# Scratch and reference material. Tracked docs stay tracked; new ones need
# an explicit `git add -f`.
docs/
