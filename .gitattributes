# The polyglot hook dispatcher is parsed by both CMD.exe and sh. CRLF would
# leave stray \r in the sh branch's commands, so pin it to LF everywhere.
*.cmd text eol=lf

*.md text eol=lf
*.json text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.tpl text eol=lf

# `grep -f` reads a blank line as a pattern that matches everything, and CRLF
# leaves a stray \r on every Linux pattern, so these .txt files are pinned to LF.
plugins/cai/hooks/reduced-check-patterns.txt text eol=lf
plugins/cai/hooks/reduced-check-write-patterns.txt text eol=lf

# The upgrade-axis samples are the bytes a released version wrote (#361).
# No line-ending conversion, so every platform's checkout reads the same file.
tests/fixtures/releases/** -text
